{
  "name": "compliance-app",
  "version": "1.0.0a",
  "license": "Apache-2.0",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "lint": "eslint --ext .js,.vue,.cjs,.mjs src electron",
    "lint:fix": "eslint --fix --ext .js,.vue,.cjs,.mjs src electron",
    "format": "prettier --write \"**/*.{js,vue,json,css,scss,md,yml}\"",
    "build": "vite build",
    "build:win-portable": "electron-builder --x64 --win portable",
    "build:mac-portable": "electron-builder --mac dmg",
    "dist": "electron-builder",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:setup": "npx playwright install --with-deps"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1",
    "pdfkit": "^0.17.2",
    "pinia": "^2.2.2",
    "prettier": "^3.6.2",
    "vue-toastification": "^2.0.0-rc.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^0.13.2",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-log": "^5.4.3",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "vite": "^5.4.8",
    "vitest": "^2.0.5",
    "vue": "^3.5.18"
  },
  "test": {
    "environment": "jsdom"
  }
}
