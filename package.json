{
  "name": "compliance-app",
  "version": "1.0.0a",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "lint": "eslint --ext .js,.vue,.cjs,.mjs src",
    "lint:fix": "eslint --fix --ext .js,.vue,.cjs,.mjs src",
    "format": "prettier --write \"**/*.{js,vue,json,css,scss,md,yml}\"",
    "build": "vite build",
    "build:win-portable": "electron-builder --win portable",
    "dist": "electron-builder",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "pdfkit": "^0.17.2",
    "pinia": "^2.2.2",
    "prettier": "^3.6.2",
    "vue-toastification": "^2.0.0-rc.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^0.13.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-log": "^5.4.3",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "vite": "^5.4.8",
    "vitest": "^2.0.5",
    "vue": "^3.5.18"
  },
  "test": {
    "environment": "jsdom"
  },
  "build": {
    "appId": "com.AviationI.aviationchecklist",
    "productName": "Aviation Safety Oversight Checklist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./src/images/complianceApp.ico"
    },
    "directories": {
      "output": "dist-portable",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "main.mjs",
      "preload.js",
      "ipcHandles.js",
      "utils/**/*"
    ],
    "extraResources": [
      {
        "from": "src/images/",
        "to": "images/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
